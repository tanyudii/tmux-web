{
  "name": "tmux-web",
  "version": "1.2.1",
  "private": true,
  "description": "Self-hosted browser GUI for switching between tmux sessions, no cloud account required.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tmuxweb": "./bin/tmuxweb.ts"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "node --experimental-strip-types src/main.ts",
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "init": "node --experimental-strip-types bin/tmuxweb.ts init",
    "install-service": "node --experimental-strip-types scripts/install-service.mjs",
    "test": "node --experimental-strip-types --test src/*.test.ts src/cli/*.test.ts public/*.test.js",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage src/*.test.ts src/cli/*.test.ts public/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/ws": "8.5.13",
    "typescript": "5.7.2"
  }
}
