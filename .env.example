# Copy to .env and fill in real values. Never commit the real .env file
# (it's already in .gitignore).

# Required. At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TMUX_WEB_TOKEN=

# Optional, defaults shown.
TMUX_WEB_PORT=5309

# Bind address. Default is loopback-only (127.0.0.1). If you're reaching
# this over WireGuard, set this to the server's WireGuard interface IP
# (check with `ip addr show wg0`) so the port is only reachable through
# the VPN tunnel, not the raw LAN or a misconfigured router.
TMUX_WEB_BIND_HOST=127.0.0.1

# Optional. Where projects.json and worktrees/ are stored. Defaults to
# ~/.tmux-web. Change this if you want project data on a different disk
# (e.g. one with more space for many worktrees).
TMUX_WEB_DATA_DIR=
