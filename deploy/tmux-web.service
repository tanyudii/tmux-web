# Install as a systemd --user service so it runs as your own user, not
# root (a shell-access tool has no business running as root).
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/tmux-web.service ~/.config/systemd/user/
#   # edit WorkingDirectory below to match where you cloned this repo
#   systemctl --user daemon-reload
#   systemctl --user enable --now tmux-web
#   loginctl enable-linger $USER   # keep it running after you log out / reboot without logging in

[Unit]
Description=tmux-web - browser GUI for tmux sessions
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/go/src/github.com/tanyudii/tmux-web
EnvironmentFile=%h/go/src/github.com/tanyudii/tmux-web/.env
ExecStart=/usr/bin/env node --experimental-strip-types src/main.ts
Restart=on-failure
RestartSec=2

# Defense in depth: filesystem access is scoped to this service, and the
# service still runs as the systemd --user account (not root). /tmp must
# stay writable because that's where tmux keeps its server socket
# (/tmp/tmux-$UID/); without it the tmux server can't even start.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/go/src/github.com/tanyudii/tmux-web /tmp

[Install]
WantedBy=default.target
