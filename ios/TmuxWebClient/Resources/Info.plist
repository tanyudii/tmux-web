<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>tmux-web</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Used to protect access to your tmux-web server token.</string>

	<!--
	tmux-web has no TLS of its own by design (see repo README: "terminate
	TLS at your VPN/reverse proxy, not here"). It is only reachable over a
	private VPN tunnel (WireGuard/Tailscale/etc.), which already encrypts
	the connection end-to-end -- plain HTTP/WS *inside* that tunnel is not
	the same risk as plain HTTP on the open internet.

	iOS App Transport Security still blocks cleartext by default, so we
	add a narrowly scoped exception for exactly one host: the VPN address
	of the tmux-web server. Replace TMUX_WEB_VPN_HOST below with your
	server's VPN IP or hostname (e.g. 100.x.x.x for Tailscale, or your
	WireGuard interface IP) before building.

	Do NOT change this to NSAllowsArbitraryLoads -- that would exempt
	every host the app talks to, not just this one.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>TMUX_WEB_VPN_HOST</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
